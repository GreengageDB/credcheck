LOAD 'credcheck';
SET credcheck.password_change_first_login = true;
CREATE USER aaa PASSWORD 'DummY';
-- verify that credcheck_internal.force_change_password is present after user creation
SELECT 1 FROM pg_catalog.pg_db_role_setting JOIN pg_catalog.pg_roles ON oid = setrole WHERE rolname='aaa' AND 'credcheck_internal.force_change_password=true'=ANY(setconfig);
 ?column? 
----------
        1
(1 row)

-- and on all segments
SELECT count(DISTINCT gp_segment_id) = (SELECT count(*) FROM gp_segment_configuration WHERE role = 'p' AND content >= 0)
  FROM gp_dist_random('pg_catalog.pg_db_role_setting')
  WHERE setrole = (SELECT oid FROM pg_catalog.pg_roles WHERE rolname='aaa') AND 'credcheck_internal.force_change_password=true'=ANY(setconfig);
 ?column? 
----------
 t
(1 row)

DROP USER aaa;
