-- pg_check_password() takes the password as an ordinary argument, so its
-- literals must be masked in the log as the PASSWORD clause is
CREATE EXTENSION credcheck;
-- GPORCA logs its fallback for the function at LOG level
SET optimizer = off;
SET log_statement = 'all';
SET client_min_messages = LOG;
SELECT pg_check_password('credtest', 'H8Hdre=S2');
LOG:  statement: SELECT pg_check_password('........', '.........');
 pg_check_password 
-------------------
 t
(1 row)

SELECT public.pg_check_password ( username := 'credtest',
  password := E'H8\\Hdre=S2' ) AS checked;
LOG:  statement: SELECT public.pg_check_password ( username := '........',
  password := E'...........' ) AS checked;
 checked 
---------
 t
(1 row)

SELECT pg_check_password('credtest', $pwd$H8Hdre=S2$pwd$),
  'not a password' AS note;
LOG:  statement: SELECT pg_check_password('........', $pwd$.........$pwd$),
  'not a password' AS note;
 pg_check_password |      note      
-------------------+----------------
 t                 | not a password
(1 row)

-- fail, the password is too short, but it's still masked in the log
SET credcheck.password_min_length = 12;
LOG:  statement: SET credcheck.password_min_length = 12;
LOG:  statement: SET "credcheck.password_min_length" TO 12
LOG:  statement: SET "credcheck.password_min_length" TO 12
LOG:  statement: SET "credcheck.password_min_length" TO 12
SELECT pg_check_password('credtest', 'H8Hdre=S2');
LOG:  statement: SELECT pg_check_password('........', '.........');
LOG:  An exception was encountered during the execution of statement: SELECT pg_check_password('........', '.........');
ERROR:  password length should match the configured credcheck.password_min_length (12)
RESET client_min_messages;
LOG:  statement: RESET client_min_messages;
LOG:  statement: RESET client_min_messages
LOG:  statement: RESET client_min_messages
LOG:  statement: RESET client_min_messages
RESET log_statement;
RESET credcheck.password_min_length;
RESET optimizer;
DROP EXTENSION credcheck CASCADE;
