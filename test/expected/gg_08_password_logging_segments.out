-- The segments log the statements dispatched by the coordinator, so the
-- password must be masked there too. Without log_statement the coordinator
-- logs the statement only after it has been dispatched.
-- start_matchsubs
-- m/^LOG:  duration: \d+\.\d+ ms/
-- s/^LOG:  duration: \d+\.\d+ ms/LOG:  duration: X ms/
-- end_matchsubs
SET log_statement = 'none';
SET log_min_duration_statement = 0;
SET client_min_messages = LOG;
LOG:  duration: 0.038 ms  statement: SET client_min_messages TO 'log'
LOG:  duration: 0.036 ms  statement: SET client_min_messages TO 'log'
LOG:  duration: 0.044 ms  statement: SET client_min_messages TO 'log'
LOG:  duration: 0.211 ms  statement: SET client_min_messages = LOG;
CREATE USER credtest PASSWORD 'H8Hdre=S2';
NOTICE:  resource queue required -- using default resource queue "pg_default"
LOG:  duration: 0.238 ms  statement: CREATE USER credtest PASSWORD '.........';
LOG:  duration: 0.232 ms  statement: CREATE USER credtest PASSWORD '.........';
LOG:  duration: 0.269 ms  statement: CREATE USER credtest PASSWORD '.........';
LOG:  duration: 1.530 ms  statement: CREATE USER credtest PASSWORD '.........';
RESET client_min_messages;
RESET log_min_duration_statement;
RESET log_statement;
DROP USER credtest;
